# =====================================================================
# CivicFix — server environment
# Copy to .env and fill in real values.
# Deploy on Render: paste every variable into the "Environment" tab.
# =====================================================================

PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/civicfix?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini (server-side vision analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Cloudflare Turnstile (bot protection)
TURNSTILE_SECRET_KEY=
# IMPORTANT: MUST be false in production!
TURNSTILE_DEV_BYPASS=false

# Email (Gmail app password — OTPs are sent to REAL inboxes)
SYSTEM_EMAIL=
SYSTEM_EMAIL_PASSWORD=
EMAIL_FROM_NAME=CivicFix
EMAIL_ENABLED=true

# Super admin (receives authority-authorization codes)
SUPER_ADMIN_EMAIL=

# Comma-separated allowed origins — set this to your Vercel deployment URL in production
# Example: FRONTEND_URL=https://civicfix.vercel.app
FRONTEND_URL=https://your-app.vercel.app

NODE_ENV=production

# Database connection pool
# Neon free tier: max 5 simultaneous connections
DB_POOL_MAX=5
DB_POOL_MIN=1

# Spatial & DAG tuning
H3_RESOLUTION=10
SPATIAL_RATE_LIMIT_HOURS=1
ESCALATION_ACTIVE_HOURS=72
CONTESTED_RESOLUTION_HOURS=48
REGION_BUFFER_METERS=1000
NOMINATIM_USER_AGENT=CivicFix/1.0 (contact: your-email@example.com)
